{
  "lessons": {
    "3": {
      "title": "Глаголы на -ω (настоящее время)",
      "grammar": "Глаголы в греческом языке в настоящем времени имеют следующие окончания:\n\nЕдинственное число:\n1-е лицо: -ω\n2-е лицо: -εις\n3-е лицо: -ει\n\nМножественное число:\n1-е лицо: -ομεν\n2-е лицо: -ετε\n3-е лицо: -ουσι(ν)\n\nПример спряжения глагола λύω (развязываю):\nλύω, λύεις, λύει, λύομεν, λύετε, λύουσι(ν)\n\nСоединительный гласный: перед μ и ν — ο, перед другими буквами — ε.",
      "vocabulary": [
        {"greek": "βλέπω", "translation": "вижу"},
        {"greek": "γινώσκω", "translation": "знаю"},
        {"greek": "γράφω", "translation": "пишу"},
        {"greek": "διδάσκω", "translation": "учу"},
        {"greek": "ἔχω", "translation": "имею"},
        {"greek": "λαμβάνω", "translation": "беру, получаю"},
        {"greek": "λέγω", "translation": "говорю"},
        {"greek": "λύω", "translation": "развязываю, освобождаю"}
      ],
      "conjugation": {
        "verb": "λύω",
        "singular": {"1": "λύω", "2": "λύεις", "3": "λύει"},
        "plural": {"1": "λύομεν", "2": "λύετε", "3": "λύουσι(ν)"}
      },
      "exercises": {
        "conjugation_fill": [
          {"person": "1", "number": "singular", "correct": "λύω", "distractors": ["λύεις", "λύει", "λύομεν"]},
          {"person": "2", "number": "singular", "correct": "λύεις", "distractors": ["λύω", "λύει", "λύετε"]},
          {"person": "3", "number": "singular", "correct": "λύει", "distractors": ["λύω", "λύεις", "λύουσι"]},
          {"person": "1", "number": "plural", "correct": "λύομεν", "distractors": ["λύω", "λύετε", "λύουσι"]},
          {"person": "2", "number": "plural", "correct": "λύετε", "distractors": ["λύομεν", "λύει", "λύουσι"]},
          {"person": "3", "number": "plural", "correct": "λύουσι(ν)", "distractors": ["λύομεν", "λύετε", "λύει"]}
        ],
        "translate_greek_to_russian": [
          {"greek": "βλέπω", "keywords": ["вижу"]},
          {"greek": "γινώσκεις", "keywords": ["знаешь"]},
          {"greek": "γράφει", "keywords": ["пишет"]},
          {"greek": "διδάσκομεν", "keywords": ["учим"]},
          {"greek": "ἔχετε", "keywords": ["имеете"]},
          {"greek": "λαμβάνουσι", "keywords": ["берут"]},
          {"greek": "λέγομεν", "keywords": ["говорим"]},
          {"greek": "λύει", "keywords": ["развязывает"]},
          {"greek": "βλέπουσι", "keywords": ["видят"]},
          {"greek": "γινώσκομεν", "keywords": ["знаем"]}
        ],
        "translate_russian_to_greek": [
          {"russian": "я вижу", "correct_sequence": ["βλέπω"], "all_words": ["βλέπω", "γινώσκω", "γράφω"]},
          {"russian": "ты знаешь", "correct_sequence": ["γινώσκεις"], "all_words": ["γινώσκεις", "γράφεις", "βλέπεις"]},
          {"russian": "он пишет", "correct_sequence": ["γράφει"], "all_words": ["γράφει", "λέγει", "λύει"]},
          {"russian": "мы учим", "correct_sequence": ["διδάσκομεν"], "all_words": ["διδάσκομεν", "γράφομεν", "βλέπομεν"]},
